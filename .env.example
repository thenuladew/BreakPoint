# ============================================================
# BREAKPOINT CTF – Environment Variables Template
# ============================================================
# Copy this file to .env before running:
#   cp .env.example .env
# Then fill in your values. NEVER commit .env to version control.
# ============================================================

# ── Flask Application ────────────────────────────────────────
FLASK_ENV=production

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret

# Salt used when hashing flags for storage. Change this before first run.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
FLAG_SALT=CHANGE_ME_random_salt_value

# Admin dashboard password
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ── Stage Flags ──────────────────────────────────────────────
# Set the plaintext flags here. The platform will hash them with FLAG_SALT
# at startup. Format: BP{lowercase_words_and_digits}

FLAG_STAGE1=BP{kavach_contractor_found}
FLAG_STAGE2=BP{idor_unlocked_portal_access}
FLAG_STAGE3=BP{vigenere_silence_broken}
FLAG_STAGE4=BP{steghide_payload_extracted}
FLAG_STAGE5=BP{xor_obfuscation_reversed}
FLAG_STAGE6=BP{sovereign_launch_revoked}

# ── Stage 5 & 6 Artifacts ────────────────────────────────────
# The authorization token embedded in the Stage 5 binary output.
# Must match the token hardcoded in the C source and the Stage 6 API check.
STAGE5_AUTH_TOKEN=SOV-AUTH-TOKEN-2048-XRAY

# The client identifier IoC embedded in the binary (also present in the PCAP).
STAGE5_CLIENT_ID=SOV-INJ-CLIENT-9914

# The exact session_id in the PCAP that represents the fraudulent authorization.
# Players must identify this through log correlation and submit it via Stage 6 API.
FRAUDULENT_SESSION_ID=sess_8f3a1d92c047

# ── Contractor Persona (Stage 1 → 2 → 3 chain) ───────────────
# These values define the handoff clues across stages.
CONTRACTOR_USERNAME=dperera_ext
CONTRACTOR_JOB_TITLE=Senior Systems Integration Lead
VIGENERE_KEY=seniorsystemsintegrationlead    # derived from job title (lowercase, no spaces)
STAGE4_FOLDER_PATH=/repo/classified_assets_2048/
STAGE4_STEGHIDE_PASSPHRASE=s0vere1gn_w4rn1ng_2048
